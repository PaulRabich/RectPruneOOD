{
	"name": "OOD Baseline",
	"build": {
		"dockerfile": "../Dockerfile" // Path is relative to the devcontainer.json file.
	},

	"remoteUser": "root",
	"mounts": [
		"source=/storage-01/datasets/imagenet/,target=/workspaces/RectPruneOOD/datasets/id_datasets/imagenet,type=bind,consistency=cached"
	],
	"customizations": {
		"vscode": {
			"extensions": [
				"ms-python.python",
				"ms-python.debugpy",
				"ms-toolsai.jupyter",
				"ms-python.black-formatter"
			]
		}
	},
	"runArgs": [
		"--gpus=device=14" , "--shm-size=2g"
    ]
}